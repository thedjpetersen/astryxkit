{
  "name": "astryxkit",
  "version": "0.2.0",
  "description": "The Astryx UI kit and compatibility package for App Foundry applications.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ak": "dist/cli/index.js",
    "astryxkit": "dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedjpetersen/astryxkit.git"
  },
  "bugs": {
    "url": "https://github.com/thedjpetersen/astryxkit/issues"
  },
  "homepage": "https://thedjpetersen.github.io/astryxkit/",
  "keywords": [
    "astryx",
    "app-foundry",
    "design-system",
    "react",
    "ui-kit"
  ],
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "docs/generators.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./design-system": {
      "types": "./dist/design-system/index.d.ts",
      "import": "./dist/design-system/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build -w app-foundry && tsc -p tsconfig.build.json",
    "check": "npm run check -w app-foundry && tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "docs:build": "vite build --config site/vite.config.ts",
    "docs:contrast": "node site/scripts/contrast.mjs",
    "docs:dev": "vite --config site/vite.config.ts --host 127.0.0.1",
    "docs:preview": "vite preview --config site/vite.config.ts --host 127.0.0.1",
    "docs:screenshot": "node site/scripts/screenshot.mjs",
    "prepare": "npm run build",
    "test": "npm run build -w app-foundry && vitest run",
    "validate": "npm run check && npm run test && npm run build && npm run docs:build && npm run docs:contrast"
  },
  "dependencies": {
    "app-foundry": "0.1.0"
  },
  "peerDependencies": {
    "@astryxdesign/core": "^0.7.1",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.1",
    "@astryxdesign/core": "^0.7.1",
    "@babel/core": "^8.0.7",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/stylex": "^0.19.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "~5.0.5",
    "wrangler": "^4.151.1"
  }
}
